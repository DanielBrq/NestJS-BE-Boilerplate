# ============================================================================
# PRE-PUSH HOOK - RUNS TESTS BEFORE PUSHING
# ============================================================================

# Change to the api-service directory
cd api-service || {
  echo "Error: Could not change to api-service directory"
  exit 1
}

# Run tests
echo "Running tests..."
pnpm run test

# Check if tests passed
if [ $? -ne 0 ]; then
  echo "Tests failed. Please fix the tests before pushing."
  exit 1
fi

echo "Tests passed. Proceeding with push..."
